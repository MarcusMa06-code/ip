<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<BorderPane prefHeight="720.0" prefWidth="980.0" styleClass="help-window"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="samantha.ui.HelpWindow">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="help-header">
            <children>
                <Label styleClass="help-brand" text="Samantha" />
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="help-header-title" text="A little guide to getting things done" />
                        <Label styleClass="help-header-subtitle" text="Everything you can say to Samantha, in one place." />
                    </children>
                </VBox>
                <Button mnemonicParsing="false" onAction="#closeWindow" styleClass="help-close-button"
                        text="Close" />
            </children>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="help-scroll-pane">
            <content>
                <VBox spacing="22.0" styleClass="help-content">
                    <children>
                        <VBox spacing="5.0" styleClass="help-intro">
                            <children>
                                <Label styleClass="help-eyebrow" text="QUICK GUIDE" />
                                <Label styleClass="help-title" text="Talk to Samantha in plain commands." />
                                <Label styleClass="help-description" wrapText="true"
                                       text="Start with a task, add a date when you need one, then use the task number to update it. Every example below can be copied into the conversation." />
                            </children>
                        </VBox>

                        <Label styleClass="help-section-title" text="Start here" />
                        <VBox spacing="12.0">
                            <children>
                                <VBox spacing="10.0" styleClass="command-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <Label styleClass="command-name" text="help" />
                                                <Label styleClass="command-tag" text="GUIDE" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="command-description" text="Open this guide whenever you need a reminder." />
                                        <Label styleClass="syntax-label" text="SYNTAX" />
                                        <Label styleClass="syntax-value" text="help" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <Label styleClass="help-section-title" text="Add tasks" />
                        <VBox spacing="12.0">
                            <children>
                                <VBox spacing="10.0" styleClass="command-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <Label styleClass="command-name" text="todo" />
                                                <Label styleClass="command-tag" text="TASK" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="command-description" text="Add something you want to remember." />
                                        <Label styleClass="syntax-label" text="SYNTAX" />
                                        <Label styleClass="syntax-value" text="todo DESCRIPTION" />
                                        <Label styleClass="syntax-label" text="EXAMPLE" />
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="example-row">
                                            <children>
                                                <TextArea editable="false" focusTraversable="false" prefRowCount="1"
                                                          styleClass="example-field" text="todo read chapter 5" wrapText="true" HBox.hgrow="ALWAYS" />
                                                <Button mnemonicParsing="false" onAction="#copyCommand" styleClass="copy-button"
                                                        text="Copy" userData="todo read chapter 5" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                <VBox spacing="10.0" styleClass="command-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <Label styleClass="command-name" text="deadline" />
                                                <Label styleClass="command-tag" text="DATE" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="command-description" text="Add a task that must be completed by a date and optional time." />
                                        <Label styleClass="syntax-label" text="SYNTAX" />
                                        <Label styleClass="syntax-value" text="deadline DESCRIPTION /by DATE [TIME]" />
                                        <Label styleClass="syntax-label" text="EXAMPLE" />
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="example-row">
                                            <children>
                                                <TextArea editable="false" focusTraversable="false" prefRowCount="1"
                                                          styleClass="example-field" text="deadline submit report /by 12/9/2026 1800" wrapText="true" HBox.hgrow="ALWAYS" />
                                                <Button mnemonicParsing="false" onAction="#copyCommand" styleClass="copy-button"
                                                        text="Copy" userData="deadline submit report /by 12/9/2026 1800" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                <VBox spacing="10.0" styleClass="command-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <Label styleClass="command-name" text="event" />
                                                <Label styleClass="command-tag" text="DATE" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="command-description" text="Add an event with a start and end time." />
                                        <Label styleClass="syntax-label" text="SYNTAX" />
                                        <Label styleClass="syntax-value" text="event DESCRIPTION /from DATE TIME /to DATE TIME" />
                                        <Label styleClass="syntax-label" text="EXAMPLE" />
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="example-row">
                                            <children>
                                                <TextArea editable="false" focusTraversable="false" prefRowCount="1"
                                                          styleClass="example-field" text="event project meeting /from 12/9/2026 1400 /to 12/9/2026 1600" wrapText="true" HBox.hgrow="ALWAYS" />
                                                <Button mnemonicParsing="false" onAction="#copyCommand" styleClass="copy-button"
                                                        text="Copy" userData="event project meeting /from 12/9/2026 1400 /to 12/9/2026 1600" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <Label styleClass="help-section-title" text="Find and manage" />
                        <VBox spacing="12.0">
                            <children>
                                <VBox spacing="10.0" styleClass="command-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <Label styleClass="command-name" text="list" />
                                                <Label styleClass="command-tag" text="VIEW" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="command-description" text="Show every task, or only tasks on a particular date." />
                                        <Label styleClass="syntax-label" text="SYNTAX" />
                                        <Label styleClass="syntax-value" text="list [DATE]" />
                                        <Label styleClass="syntax-label" text="EXAMPLE" />
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="example-row">
                                            <children>
                                                <TextArea editable="false" focusTraversable="false" prefRowCount="1"
                                                          styleClass="example-field" text="list 12/9/2026" wrapText="true" HBox.hgrow="ALWAYS" />
                                                <Button mnemonicParsing="false" onAction="#copyCommand" styleClass="copy-button"
                                                        text="Copy" userData="list 12/9/2026" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                <VBox spacing="10.0" styleClass="command-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <Label styleClass="command-name" text="find" />
                                                <Label styleClass="command-tag" text="SEARCH" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="command-description" text="Find tasks whose descriptions contain a keyword." />
                                        <Label styleClass="syntax-label" text="SYNTAX" />
                                        <Label styleClass="syntax-value" text="find KEYWORD" />
                                        <Label styleClass="syntax-label" text="EXAMPLE" />
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="example-row">
                                            <children>
                                                <TextArea editable="false" focusTraversable="false" prefRowCount="1"
                                                          styleClass="example-field" text="find report" wrapText="true" HBox.hgrow="ALWAYS" />
                                                <Button mnemonicParsing="false" onAction="#copyCommand" styleClass="copy-button"
                                                        text="Copy" userData="find report" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                <VBox spacing="10.0" styleClass="command-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <Label styleClass="command-name" text="mark / unmark" />
                                                <Label styleClass="command-tag" text="STATUS" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="command-description" text="Mark a task as done, or reopen it using its number." />
                                        <Label styleClass="syntax-label" text="SYNTAX" />
                                        <Label styleClass="syntax-value" text="mark N    ·    unmark N" />
                                        <Label styleClass="syntax-label" text="EXAMPLE" />
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="example-row">
                                            <children>
                                                <TextArea editable="false" focusTraversable="false" prefRowCount="1"
                                                          styleClass="example-field" text="mark 1" wrapText="true" HBox.hgrow="ALWAYS" />
                                                <Button mnemonicParsing="false" onAction="#copyCommand" styleClass="copy-button"
                                                        text="Copy" userData="mark 1" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                <VBox spacing="10.0" styleClass="command-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <Label styleClass="command-name" text="delete" />
                                                <Label styleClass="command-tag" text="REMOVE" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="command-description" text="Remove a task permanently using its number." />
                                        <Label styleClass="syntax-label" text="SYNTAX" />
                                        <Label styleClass="syntax-value" text="delete N" />
                                        <Label styleClass="syntax-label" text="EXAMPLE" />
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="example-row">
                                            <children>
                                                <TextArea editable="false" focusTraversable="false" prefRowCount="1"
                                                          styleClass="example-field" text="delete 1" wrapText="true" HBox.hgrow="ALWAYS" />
                                                <Button mnemonicParsing="false" onAction="#copyCommand" styleClass="copy-button"
                                                        text="Copy" userData="delete 1" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <Label styleClass="help-section-title" text="Finish" />
                        <VBox spacing="12.0">
                            <children>
                                <VBox spacing="10.0" styleClass="command-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <Label styleClass="command-name" text="bye" />
                                                <Label styleClass="command-tag" text="EXIT" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="command-description" text="Close Samantha when you are done." />
                                        <Label styleClass="syntax-label" text="SYNTAX" />
                                        <Label styleClass="syntax-value" text="bye" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <VBox spacing="4.0" styleClass="help-footer">
                            <children>
                                <Label styleClass="help-footer-title" text="Dates and times" />
                                <Label styleClass="help-footer-text" wrapText="true"
                                       text="Use dates as d/M/yyyy or d-M-yyyy, for example 12/9/2026. Use 24-hour times as HHmm, for example 1800." />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <stylesheets>
        <URL value="@../css/help.css" />
    </stylesheets>
</BorderPane>
