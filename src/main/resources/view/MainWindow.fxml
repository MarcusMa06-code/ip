<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="520.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="samantha.ui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vvalue="1.0"
                    AnchorPane.bottomAnchor="68.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="12.0" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" onAction="#handleUserInput"
                   AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="14.0"
                   AnchorPane.rightAnchor="82.0" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                text="↑" AnchorPane.bottomAnchor="12.0" AnchorPane.rightAnchor="14.0" />
    </children>
</AnchorPane>
